{
  "name": "snitchr",
  "version": "0.1.0",
  "type": "module",
  "description": "Self-hosted server monitoring powered by a zero-dependency bash agent. Runs on Cloudflare Workers, Node.js, and Bun.",
  "license": "MIT",
  "author": "Jølly Good (https://github.com/thinking-tools)",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinking-tools/snitchr.git"
  },
  "homepage": "https://github.com/thinking-tools/snitchr/",
  "bugs": {
    "url": "https://github.com/thinking-tools/snitchr/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/thinking-tools"
  },
  "keywords": [
    "server-monitoring",
    "monitoring",
    "heartbeat",
    "uptime",
    "security",
    "alerting",
    "self-hosted",
    "linux",
    "macos",
    "file-integrity",
    "intrusion-detection",
    "ssh-monitoring"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "snitchr": "dist/cli.js"
  },
  "files": [
    "dist/",
    "static/",
    "LICENSE",
    "README.md"
  ],
  "cloudflare": {
    "bindings": {
      "SNITCHR_CONFIG": {
        "description": "KV namespace for configuration and machine registry"
      },
      "SNITCHR_STORAGE": {
        "description": "R2 bucket for heartbeats, events, and alert history. If you prefer S3, you can configure it in the setup wizard after deploy."
      },
      "VAPID_CONTACT": {
        "description": "Your email for Web Push VAPID identification (e.g. `you@example.com`). Optional — only needed if you enable browser push notifications."
      }
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "dev:node": "tsx src/cli.ts",
    "build:version": "node dev/build-version.mjs",
    "deploy": "wrangler deploy",
    "prebuild:node": "rm -rf dist",
    "build:node": "npm run build:version && esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --banner:js='#!/usr/bin/env node'",
    "seed": "node dev/seed.mjs",
    "seed:status": "node dev/seed-status.mjs",
    "seed:collect": "node dev/collect.mjs",
    "clear": "wrangler kv key delete --binding SNITCHR_CONFIG \"config\" --local",
    "test:agent": "cd test && ./run.sh",
    "test:agent:logs": "docker compose -f test/docker-compose.yml logs -f gateway",
    "test:agent:down": "docker compose -f test/docker-compose.yml down",
    "test:e2e": "VARIANT=all bash test/e2e/run.sh",
    "test:e2e:bun": "VARIANT=bun bash test/e2e/run.sh",
    "test:e2e:cf": "VARIANT=cf bash test/e2e/run.sh",
    "test:e2e:down": "bash test/e2e/run.sh --down",
    "test:fuzz": "bash test/fuzz.sh",
    "sandbox": "bash dev/sandbox.sh",
    "sandbox:wipe": "bash dev/sandbox.sh --wipe",
    "format": "prettier --write 'src/**/*.ts' 'static/**/*.{html,css,js}'",
    "format:check": "prettier --check 'src/**/*.ts' 'static/**/*.{html,css,js}'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:unit": "vitest run --dir src --exclude 'src/__tests__/**'",
    "test:integration": "vitest run --dir src/__tests__/integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "copy:vendor": "node dev/copy-vendor.mjs",
    "prepublishOnly": "npm run test && npm run build:node && npm run copy:vendor"
  },
  "dependencies": {
    "@hono/node-server": "1.19.14",
    "@noble/hashes": "2.2.0",
    "hono": "4.12.14",
    "s3mini": "0.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260420.1",
    "@fast-check/vitest": "0.4.0",
    "@types/node": "25.6.0",
    "@vitest/coverage-v8": "4.1.4",
    "esbuild": "0.28.0",
    "oat-glassed": "0.2.2",
    "prettier": "3.8.3",
    "three": "0.184.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.4",
    "world-atlas": "2.0.2",
    "wrangler": "4.83.0"
  },
  "prettier": {
    "bracketSpacing": true,
    "bracketSameLine": false,
    "singleQuote": true,
    "semi": true,
    "endOfLine": "lf",
    "tabWidth": 2,
    "trailingComma": "all",
    "arrowParens": "avoid",
    "printWidth": 120
  }
}

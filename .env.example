# snitchr environment variables
# Copy to .env and fill in your values.

# Your email for Web Push VAPID identification (required for browser push notifications)
VAPID_CONTACT=you@example.com

# S3-compatible storage (optional — alternative to R2)
# Format: provider,access_key,secret_key,endpoint,region
# BUCKET_ENV_S3=cloudflare,<access_key>,<secret_key>,<endpoint>,auto
